class Solution {
public:
    vector<int> selfDividingNumbers(int left, int right) {
        vector<int> result;

        for (int num = left; num <= right; num++) {
            if (isSelfDividing(num))
                result.push_back(num);
        }

        return result;
    }

private:
    bool isSelfDividing(int num) {
        int n = num;

        while (n > 0) {
            int digit = n % 10;

            if (digit == 0 || num % digit != 0)
                return false;

            n /= 10;
        }

        return true;
    }
};
